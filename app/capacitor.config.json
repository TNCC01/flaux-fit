{
  "appId": "au.com.flaux.fit.app",
  "appName": "FIT by Flaux",
  "webDir": "www",
  "backgroundColor": "#050a0a",
  "ios": {
    "contentInset": "never"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 200,
      "backgroundColor": "#050a0a",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK"
    },
    "SystemBars": {
      "insetsHandling": "native",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    }
  }
}
